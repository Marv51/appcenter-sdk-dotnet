<?xml version="1.0"?>
<package>
  <metadata>
    <id>Telani.AppCenter.Crashes</id>
    <title>Telani App Center Crashes</title>
    <authors>telani, based on Microsoft Open Source</authors>
    <owners>microsoft,appcenter</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <summary>Microsoft App Center Crashes package provides crash reporting capabilities for your mobile applications.</summary>
    <description>This package contains functionalities to collect crash reports for your application.</description>
    <copyright>© Microsoft Corporation. All rights reserved.</copyright>
    <tags>app center appcenter crashes mobilecenter</tags>
    <language>en-US</language>
    <projectUrl>https://aka.ms/telgml</projectUrl>
    <license type="expression">MIT</license>
    <iconUrl>https://aka.ms/k76877</iconUrl>
    <dependencies>
      <group>
        <dependency id="Telani.AppCenter" version="$version$" />
      </group>
    </dependencies>
    <version>$version$</version>
  </metadata>
  <files>

    <!-- Windows Desktop for WinUI and modern OS targets -->
    <file src="$windows_net8_dir$/Microsoft.AppCenter.Crashes.dll" target="lib/net8.0-windows10.0.22621.0" />
    <file src="$windows_net8_dir$/Microsoft.AppCenter.Crashes.xml" target="lib/net8.0-windows10.0.22621.0" />
  </files>
</package>
