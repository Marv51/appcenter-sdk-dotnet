    <iconUrl>https://aka.ms/k76877</iconUrl>
    <dependencies>
      <dependency id="Telani.AppCenter" version="$version$" />
    </dependencies>
    <version>$version$</version>
  </metadata>
  <files>
    <!-- Windows Desktop for WinUI and modern OS targets -->
    <file src="$windows_net8_dir$/Microsoft.AppCenter.Analytics.dll" target="lib/net8.0-windows10.0.22621.0" />
    <file src="$windows_net8_dir$/Microsoft.AppCenter.Analytics.xml" target="lib/net8.0-windows10.0.22621.0" />
  </files>
